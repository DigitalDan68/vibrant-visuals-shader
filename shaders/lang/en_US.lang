option.LABPBR=labPBR 1.3 resource pack materials
option.LABPBR.comment=Enable terrain normal maps, smoothness, reflectance, metals, material AO and emission. Requires a labPBR 1.3 resource pack.

screen.MATERIALS_SCREEN=Materials
screen.GRADING_SCREEN=Color Grading
option.COLOR_GRADING=Color Grading
value.COLOR_GRADING.0=Normal
value.COLOR_GRADING.1=Vibrant Visuals
option.LABPBR_NORMAL_STRENGTH=Normal Map Strength
option.LABPBR_NORMAL_STRENGTH.comment=Controls surface relief from normal maps. Zero uses geometric normals.
option.LABPBR_ROUGHNESS_SCALE=Roughness Scale
option.LABPBR_ROUGHNESS_SCALE.comment=Higher values soften material highlights and reduce sharp reflections. One follows the resource pack.
option.LABPBR_SPECULAR_STRENGTH=Specular Strength
option.LABPBR_SPECULAR_STRENGTH.comment=Controls highlights and material reflections. Zero disables specular lighting.
option.LABPBR_AO_STRENGTH=Material Occlusion Strength
option.LABPBR_AO_STRENGTH.comment=Controls occlusion from the normal map blue channel. Zero disables material AO.
option.LABPBR_EMISSION_STRENGTH=Emission Brightness
option.LABPBR_EMISSION_STRENGTH.comment=Controls emissive texture brightness. Zero disables texture emission. Emissive surfaces do not cast light onto nearby blocks.


